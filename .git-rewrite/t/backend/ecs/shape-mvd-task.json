{
  "family": "petplantr-shape-mvd",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "placementConstraints": [
    {
      "type": "memberOf",
      "expression": "attribute:ecs.instance-type =~ g4dn.*"
    }
  ],
  "cpu": "4096",
  "memory": "16384",
  "taskRoleArn": "arn:aws:iam::680604703891:role/ecsTaskRole",
  "executionRoleArn": "arn:aws:iam::680604703891:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "shape-mvd",
      "image": "680604703891.dkr.ecr.us-east-1.amazonaws.com/petplantr-shape-mvd:latest",
      "essential": true,
      "memory": 15360,
      "memoryReservation": 12288,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "us-east-1"
        },
        {
          "name": "CUDA_VISIBLE_DEVICES",
          "value": "0"
        },
        {
          "name": "TORCH_HOME",
          "value": "/app/cache"
        },
        {
          "name": "HF_HOME",
          "value": "/app/cache"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "tmp",
          "containerPath": "/tmp",
          "readOnly": false
        }
      ],
      "resourceRequirements": [
        {
          "type": "GPU",
          "value": "1"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/petplantr-shape-mvd",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python src/health_check.py"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ],
  "volumes": [
    {
      "name": "tmp",
      "host": {
        "sourcePath": "/tmp"
      }
    }
  ],
  "tags": [
    {
      "key": "Service",
      "value": "PetPlantr"
    },
    {
      "key": "Component",
      "value": "ShapeMVD"
    }
  ]
}
