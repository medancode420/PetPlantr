{
  "Comment": "PetPlantr order pipeline",
  "StartAt": "ValidateOrder",
  "States": {
    "ValidateOrder": {
      "Type": "Pass",
      "Comment": "Validate order data and user permissions",
      "Parameters": {
        "orderId.$": "$.orderId",
        "userId.$": "$.userId",
        "sku.$": "$.sku",
        "sizeTier.$": "$.sizeTier",
        "photoKeys.$": "$.photoKeys",
        "sessionId.$": "$.sessionId",
        "timestamp.$": "$.timestamp",
        "status": "VALIDATED",
        "validatedAt.$": "$$.State.EnteredTime"
      },
      "Next": "DownloadPhotos"
    },
    "DownloadPhotos": {
      "Type": "Task",
      "Comment": "Download user photos from S3 uploads bucket",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${DownloadPhotosLambdaFunction}",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "photoKeys.$": "$.photoKeys",
          "uploadBucket": "${UPLOAD_BUCKET}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "MeshCleanup"
    },
    "MeshCleanup": {
      "Type": "Task",
      "Comment": "Generate 3D STL mesh from photos using Shape-MVD",
      "Resource": "arn:aws:lambda:${AWS_REGION}:*:function:meshCleanup",
      "Parameters": {
        "orderId.$": "$.orderId",
        "userId.$": "$.userId",
        "photoKeys.$": "$.photoKeys",
        "sizeTier.$": "$.sizeTier",
        "rawStlBucket": "${RAW_STL_BUCKET}"
      },
      "TimeoutSeconds": 300,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "SliceAndQueue"
    },
    "SliceAndQueue": {
      "Type": "Task",
      "Comment": "Clean and validate STL mesh for 3D printing",
      "Resource": "arn:aws:lambda:${AWS_REGION}:*:function:slicerDispatcher",
      "Parameters": {
        "orderId.$": "$.orderId",
        "userId.$": "$.userId",
        "rawStlKey.$": "$.rawStlKey",
        "sizeTier.$": "$.sizeTier",
        "readyStlBucket": "${READY_STL_BUCKET}"
      },
      "TimeoutSeconds": 180,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "NotifyCustomer"
    },
    "NotifyCustomer": {
      "Type": "Task",
      "Comment": "Send completion notification to customer",
      "Resource": "arn:aws:lambda:${AWS_REGION}:*:function:notifyCustomer",
      "Parameters": {
        "orderId.$": "$.orderId",
        "userId.$": "$.userId",
        "readyStlKey.$": "$.readyStlKey",
        "status": "COMPLETED"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2
        }
      ],
      "End": true
    },
    "HandleError": {
      "Type": "Task",
      "Comment": "Handle processing errors and notify stakeholders",
      "Resource": "arn:aws:lambda:${AWS_REGION}:*:function:handleError",
      "Parameters": {
        "orderId.$": "$.orderId",
        "userId.$": "$.userId",
        "error.$": "$.Error",
        "cause.$": "$.Cause",
        "status": "FAILED"
      },
      "End": true
    }
  }
}
