{
  "Comment": "PetPlantr Enhanced AI Pipeline - Museum Quality Pet Planters",
  "StartAt": "ValidateOrder",
  "States": {
    "ValidateOrder": {
      "Type": "Pass",
      "Comment": "Validate incoming order data",
      "Next": "ChooseProcessingPath"
    },
    "ChooseProcessingPath": {
      "Type": "Choice",
      "Comment": "Choose between AI pipeline or simple pipeline based on feature flag",
      "Choices": [
        {
          "Variable": "$.useAIPipeline",
          "BooleanEquals": true,
          "Next": "DownloadPhotosAI"
        }
      ],
      "Default": "DownloadPhotos"
    },
    "DownloadPhotosAI": {
      "Type": "Task",
      "Comment": "Download photos for AI processing",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-downloadPhotos",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "photoUrls.$": "$.photoUrls"
        }
      },
      "TimeoutSeconds": 60,
      "Next": "FeatureExtraction"
    },
    "FeatureExtraction": {
      "Type": "Task",
      "Comment": "AI Stage 1: Extract facial features using Vision Transformer",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-modelingPipeline",
        "Payload": {
          "stage": "featureExtraction",
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "photoUrls.$": "$.photoUrls"
        }
      },
      "TimeoutSeconds": 300,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "DepthEstimation"
    },
    "DepthEstimation": {
      "Type": "Task", 
      "Comment": "AI Stage 2: Generate depth maps using DINOv2 + MiDaS ensemble",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-modelingPipeline",
        "Payload": {
          "stage": "depthEstimation",
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "previousStageOutput.$": "$.outputPath"
        }
      },
      "TimeoutSeconds": 300,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "MeshReconstruction"
    },
    "MeshReconstruction": {
      "Type": "Task",
      "Comment": "AI Stage 3: Generate 3D mesh using Shape-MVD",
      "Resource": "arn:aws:states:::lambda:invoke", 
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-modelingPipeline",
        "Payload": {
          "stage": "meshReconstruction",
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "previousStageOutput.$": "$.outputPath"
        }
      },
      "TimeoutSeconds": 600,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 15,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "PlanterGeometry"
    },
    "PlanterGeometry": {
      "Type": "Task",
      "Comment": "AI Stage 4: Create planter geometry with boolean operations",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-modelingPipeline",
        "Payload": {
          "stage": "planterGeometry",
          "orderId.$": "$.orderId", 
          "userId.$": "$.userId",
          "previousStageOutput.$": "$.outputPath"
        }
      },
      "TimeoutSeconds": 300,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "MeshCleanupAI"
    },
    "MeshCleanupAI": {
      "Type": "Task",
      "Comment": "AI Stage 5: Clean and optimize mesh for 3D printing",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-modelingPipeline",
        "Payload": {
          "stage": "meshCleanup",
          "orderId.$": "$.orderId",
          "userId.$": "$.userId", 
          "previousStageOutput.$": "$.outputPath"
        }
      },
      "TimeoutSeconds": 240,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "TextureMarking"
    },
    "TextureMarking": {
      "Type": "Task",
      "Comment": "AI Stage 6: Apply texture and pet markings",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-modelingPipeline",
        "Payload": {
          "stage": "textureMarking",
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "previousStageOutput.$": "$.outputPath"
        }
      },
      "TimeoutSeconds": 180,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "QualityValidation"
    },
    "QualityValidation": {
      "Type": "Choice",
      "Comment": "Validate AI-generated mesh meets quality standards",
      "Choices": [
        {
          "Variable": "$.qualityMetrics.manifoldRatio",
          "NumericGreaterThan": 0.95,
          "Next": "NotifyCustomer"
        }
      ],
      "Default": "HandleError"
    },
    "DownloadPhotos": {
      "Type": "Task",
      "Comment": "Download user photos from S3 uploads bucket (Legacy Beta-0 path)",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-downloadPhotos",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "photoKeys.$": "$.photoKeys",
          "uploadBucket": "petplantr-uploads-dev"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "GenerateSTL"
    },
    "GenerateSTL": {
      "Type": "Task",
      "Comment": "Generate 3D STL mesh from photos using Shape-MVD (Legacy)",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-generateSTL",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "photoKeys.$": "$.photoKeys",
          "sizeTier.$": "$.sizeTier",
          "rawStlBucket": "petplantr-stl-raw-dev"
        }
      },
      "TimeoutSeconds": 300,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "ProcessSTL"
    },
    "ProcessSTL": {
      "Type": "Task",
      "Comment": "Clean and validate STL mesh for 3D printing (Legacy)",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-processSTL",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "rawStlKey.$": "$.rawStlKey",
          "sizeTier.$": "$.sizeTier",
          "readyStlBucket": "petplantr-stl-ready-dev"
        }
      },
      "TimeoutSeconds": 180,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "NotifyPrinter"
    },
    "NotifyPrinter": {
      "Type": "Task",
      "Comment": "Send STL to K1 Max print queue",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-notifyPrinter",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "readyStlKey.$": "$.readyStlKey",
          "sizeTier.$": "$.sizeTier",
          "stlBucket": "petplantr-stl-ready-dev"
        }
      },
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError"
        }
      ],
      "Next": "NotifyCustomer"
    },
    "NotifyCustomer": {
      "Type": "Task",
      "Comment": "Send completion notification to customer",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-notifyCustomer",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "readyStlKey.$": "$.readyStlKey",
          "status": "COMPLETED"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2
        }
      ],
      "End": true
    },
    "HandleError": {
      "Type": "Task",
      "Comment": "Handle processing errors and notify stakeholders",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-handleError",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "error.$": "$.Error",
          "cause.$": "$.Cause",
          "status": "FAILED"
        }
      },
      "End": true
    }
  }
}
