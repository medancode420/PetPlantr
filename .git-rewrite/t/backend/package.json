{
  "name": "petplantr-backend",
  "version": "1.0.0",
  "description": "AWS Lambda functions for PetPlantr payment pipeline",
  "main": "index.js",
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "offline": "serverless offline",
    "logs": "serverless logs -f",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:email": "ts-node ../scripts/test-send-email.ts",
    "test:smoke": "node scripts/smokeTest.js",
    "test:smoke-e2e": "node scripts/smoke-test-e2e.js",
    "test:smoke-enhanced": "node scripts/enhancedSmokeTest.js",
    "test:integration": "jest --testPathPattern=task8-integration",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "stripe:create-smoke-price": "node scripts/create-smoke-test-price.js",
    "stripe:create-price-cli": "./scripts/create-stripe-price.sh",
    "beta:diagnostics": "npx dotenv-cli -e .env -- ./scripts/beta-diagnostics.sh",
    "beta:fix": "npx dotenv-cli -e .env -- ./scripts/beta-quick-fix.sh"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.855.0",
    "@aws-sdk/client-dynamodb": "^3.855.0",
    "@aws-sdk/client-eventbridge": "^3.456.0",
    "@aws-sdk/client-s3": "^3.456.0",
    "@aws-sdk/client-secrets-manager": "^3.830.0",
    "@aws-sdk/client-ses": "^3.456.0",
    "@aws-sdk/client-sfn": "^3.830.0",
    "@aws-sdk/client-sns": "^3.835.0",
    "@aws-sdk/client-sqs": "^3.855.0",
    "@aws-sdk/lib-dynamodb": "^3.855.0",
    "@aws-sdk/s3-request-presigner": "^3.456.0",
    "@azure/msal-node": "^3.6.1",
    "@langchain/openai": "^0.5.15",
    "@langchain/pinecone": "^0.2.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "langchain": "^0.3.29",
    "node-fetch": "^3.3.2",
    "open": "^10.1.2",
    "pinecone-client": "^2.0.0",
    "stripe": "^14.7.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.126",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.4",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "serverless": "^3.38.0",
    "serverless-offline": "^13.9.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  }
}
