    }));

    // Send cancellation event
    await eventBridge.send(new PutEventsCommand({
      Entries: [{
        Source: 'petplantr.farm',
        DetailType: 'Job Cancelled',
        Detail: JSON.stringify({
          jobId,
          timestamp: new Date().toISOString()
        })
      }]
    }));

    logger.info(`✅ Cancelled job ${jobId}`);
    return createResponse(200, { 
      message: 'Job cancelled successfully',
      jobId
    });

  } catch (error) {
    logger.error('❌ Error cancelling job:', { error: error instanceof Error ? error.message : String(error) });
    return createResponse(500, { error: 'Failed to cancel job' });
  }
}

// Utility functions for frontend optimization
function calculateEstimatedWaitTime(jobs: any[], printers: any[]): string {
  const queuedJobs = jobs.filter((j: any) => j.status === 'queued');
  const activePrinters = printers.filter((p: any) => p.status === 'idle' || p.status === 'printing');
  
  if (queuedJobs.length === 0) return '0 minutes';
  if (activePrinters.length === 0) return 'Unknown';
  
  const averageJobTime = 90; // minutes - would calculate from historical data
  const estimatedMinutes = (queuedJobs.length / activePrinters.length) * averageJobTime;
  
  if (estimatedMinutes < 60) {
    return `${Math.round(estimatedMinutes)} minutes`;
  } else {
    const hours = Math.floor(estimatedMinutes / 60);
    const minutes = Math.round(estimatedMinutes % 60);
    return `${hours}h ${minutes}m`;
  }
}

function generateFarmAlerts(printers: any[], jobs: any[]): Array<{type: string; message: string; severity: string}> {
  const alerts = [];
  
  // Check for offline printers
  const offlinePrinters = printers.filter((p: any) => p.status === 'offline');
  if (offlinePrinters.length > 0) {
    alerts.push({
      type: 'printer_offline',
      message: `${offlinePrinters.length} printer(s) are offline`,
      severity: 'warning'
    });
  }
  
  // Check for overheating
  const overheatingPrinters = printers.filter((p: any) => 
    p.temperatureNozzle > 250 || p.temperatureBed > 80
  );
  if (overheatingPrinters.length > 0) {
    alerts.push({
      type: 'temperature_high',
      message: `${overheatingPrinters.length} printer(s) running hot`,
      severity: 'error'
    });
  }
  
  // Check queue backup
  const queuedJobs = jobs.filter((j: any) => j.status === 'queued');
  if (queuedJobs.length > 10) {
    alerts.push({
      type: 'queue_backup',
      message: `${queuedJobs.length} jobs in queue - consider scaling`,
      severity: 'info'
    });
  }
  
  return alerts;
}

function calculateThroughput(jobs: any[]): number {
  // Calculate jobs completed in last 24 hours
  const yesterday = new Date();
  yesterday.setDate(yesterday.getDate() - 1);
  
  const recentJobs = jobs.filter((j: any) => 
    j.status === 'completed' && new Date(j.updatedAt) > yesterday
  );
  
  return recentJobs.length;
}

// Missing function implementations
async function getJobs(queryParams: any): Promise<APIGatewayProxyResult> {
  try {
    const limit = parseInt(queryParams?.limit || '50');
    const status = queryParams?.status;
    const priority = queryParams?.priority;
    
    let filterExpression = '';
    const expressionAttributeNames: any = {};
    const expressionAttributeValues: any = {};
    
    if (status) {
      filterExpression = '#status = :status';
      expressionAttributeNames['#status'] = 'status';
      expressionAttributeValues[':status'] = status;
    }
    
    if (priority) {
      if (filterExpression) filterExpression += ' AND ';
      filterExpression += 'priority >= :priority';
      expressionAttributeValues[':priority'] = parseInt(priority);
    }
    
    const scanParams: any = {
      TableName: JOBS_TABLE,
      Limit: limit
    };
    
    if (filterExpression) {
      scanParams.FilterExpression = filterExpression;
      scanParams.ExpressionAttributeNames = expressionAttributeNames;
      scanParams.ExpressionAttributeValues = expressionAttributeValues;
    }
    
    const response = await dynamodb.send(new DocScanCommand(scanParams));
    
    const jobs = response.Items?.map((item: any) => ({
      id: item.jobId,
      customerId: item.customerId,
      customerEmail: item.customerEmail,
      petName: item.petName,
      breed: item.breed,
      status: item.status,
      priority: item.priority,
      progress: item.assignedPrinter ? 50 : 0, // Mock progress
      materialType: item.materialType,
      materialColor: item.materialColor,
      qualityRequirements: item.qualityRequirements,
      estimatedTime: item.estimatedTime,
      assignedPrinter: item.assignedPrinter,
      createdAt: item.createdAt,
      updatedAt: item.updatedAt,
      timeline: {
        ordered: item.createdAt,
        printingStarted: item.assignedPrinter ? item.updatedAt : null
      }
    };

    await dynamodb.send(new UpdateCommand(updateParams));

    // Emit completion event
    await eventBridge.send(new PutEventsCommand({
      Entries: [{
        Source: 'petplantr.farm',
        DetailType: success ? 'Job Completed' : 'Job Failed',
        Detail: JSON.stringify({
          jobId,
          success,
          qualityScore,
          timestamp: new Date().toISOString()
        })
      }]
    }));

    logger.info(`✅ Job ${jobId} ${success ? 'completed' : 'failed'}`);
    return createResponse(200, { 
      message: `Job ${success ? 'completed' : 'failed'} successfully`,
      jobId,
      status: success ? 'completed' : 'failed'
    });

  } catch (error) {
    logger.error('❌ Error completing job:', { error: error instanceof Error ? error.message : String(error) });
    return createResponse(500, { error: 'Failed to complete job' });
  }
}

async function getFarmMetrics(timeframe: string = '24h'): Promise<APIGatewayProxyResult> {
  try {
    logger.info(`📊 Getting farm metrics for ${timeframe}`);
    
    // Calculate timeframe hours
    const hours = timeframe === '7d' ? 168 : timeframe === '30d' ? 720 : 24;
    const sinceTime = new Date(Date.now() - (hours * 60 * 60 * 1000)).toISOString();
    
    // Get completed jobs in timeframe
    const jobsResponse = await dynamodb.send(new DocScanCommand({
      TableName: JOBS_TABLE,
      FilterExpression: 'completedAt >= :sinceTime',
      ExpressionAttributeValues: {
        ':sinceTime': sinceTime
      }
    }));

    const completedJobs = jobsResponse.Items || [];
    const totalJobs = completedJobs.length;
    const successfulJobs = completedJobs.filter((job: any) => job.status === 'completed').length;
    const failedJobs = totalJobs - successfulJobs;
    
    // Calculate print time statistics
    const printTimes = completedJobs
      .filter((job: any) => job.printStartTime && job.completedAt)
      .map((job: any) => {
        const start = new Date(job.printStartTime).getTime();
        const end = new Date(job.completedAt).getTime();
        return (end - start) / (1000 * 60); // minutes
      });

    const avgPrintTime = printTimes.length > 0 
      ? printTimes.reduce((a, b) => a + b, 0) / printTimes.length 
      : 0;

    // Calculate material usage
    const materialUsage = completedJobs.reduce((acc: any, job: any) => {
      const material = job.materialType || 'PLA';
      acc[material] = (acc[material] || 0) + (job.materialUsed || 100); // grams
      return acc;
    }, {});

    const metrics = {
      timeframe,
      totalJobs,
      successfulJobs,
      failedJobs,
      successRate: totalJobs > 0 ? (successfulJobs / totalJobs) * 100 : 0,
      avgPrintTime: Math.round(avgPrintTime),
      totalPrintTime: Math.round(printTimes.reduce((a, b) => a + b, 0)),
      materialUsage,
      quality: {
        avgScore: completedJobs.length > 0 
          ? completedJobs.reduce((acc: number, job: any) => acc + (job.qualityScore || 0), 0) / completedJobs.length
          : 0,
        highQuality: completedJobs.filter((job: any) => (job.qualityScore || 0) >= 90).length,
        lowQuality: completedJobs.filter((job: any) => (job.qualityScore || 0) < 70).length
      }
    };

    return createResponse(200, { metrics });

  } catch (error) {
    logger.error('❌ Error getting farm metrics:', { error: error instanceof Error ? error.message : String(error) });
    return createResponse(500, { error: 'Failed to get farm metrics' });
  }
}
