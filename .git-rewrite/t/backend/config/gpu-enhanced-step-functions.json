{
  "Comment": "PetPlantr AI Pipeline with GPU-powered ECS containers",
  "StartAt": "CheckPipelineType",
  "States": {
    "CheckPipelineType": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.useAIPipeline",
          "BooleanEquals": true,
          "Next": "AIFeatureExtraction"
        }
      ],
      "Default": "LegacyDownloadPhotos"
    },
    
    "AIFeatureExtraction": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "TaskDefinition": "arn:aws:ecs:us-east-1:680604703891:task-definition/petplantr-feature-extraction",
        "Cluster": "arn:aws:ecs:us-east-1:680604703891:cluster/petplantr-gpu-cluster",
        "LaunchType": "EC2",
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "feature-extraction",
              "Environment": [
                {
                  "Name": "ORDER_ID",
                  "Value.$": "$.orderId"
                },
                {
                  "Name": "PHOTO_URLS",
                  "Value.$": "$.photoUrls"
                }
              ]
            }
          ]
        },
        "Tags": [
          {
            "Key": "OrderId",
            "Value.$": "$.orderId"
          },
          {
            "Key": "Stage",
            "Value": "FeatureExtraction"
          }
        ]
      },
      "ResultPath": "$.featureExtractionResult",
      "Next": "AIDepthEstimation",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleAIError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "AIDepthEstimation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "TaskDefinition": "arn:aws:ecs:us-east-1:680604703891:task-definition/petplantr-depth-estimation",
        "Cluster": "arn:aws:ecs:us-east-1:680604703891:cluster/petplantr-gpu-cluster",
        "LaunchType": "EC2",
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "depth-estimation",
              "Environment": [
                {
                  "Name": "ORDER_ID",
                  "Value.$": "$.orderId"
                },
                {
                  "Name": "FEATURE_DATA_PATH",
                  "Value.$": "$.featureExtractionResult.outputPath"
                }
              ]
            }
          ]
        },
        "Tags": [
          {
            "Key": "OrderId",
            "Value.$": "$.orderId"
          },
          {
            "Key": "Stage",
            "Value": "DepthEstimation"
          }
        ]
      },
      "ResultPath": "$.depthEstimationResult",
      "Next": "AIShapeMVD",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleAIError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "AIShapeMVD": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "TaskDefinition": "arn:aws:ecs:us-east-1:680604703891:task-definition/petplantr-shape-mvd",
        "Cluster": "arn:aws:ecs:us-east-1:680604703891:cluster/petplantr-gpu-cluster",
        "LaunchType": "EC2",
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "shape-mvd",
              "Environment": [
                {
                  "Name": "ORDER_ID",
                  "Value.$": "$.orderId"
                },
                {
                  "Name": "DEPTH_NORMAL_DATA_PATH",
                  "Value.$": "$.depthEstimationResult.outputPath"
                }
              ]
            }
          ]
        },
        "Tags": [
          {
            "Key": "OrderId",
            "Value.$": "$.orderId"
          },
          {
            "Key": "Stage",
            "Value": "ShapeMVD"
          }
        ]
      },
      "ResultPath": "$.shapeMVDResult",
      "Next": "AIPlanterGeometry",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleAIError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "AIPlanterGeometry": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-modelingPipeline",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "stage": "planterGeometry",
          "previousStageOutput.$": "$.shapeMVDResult.outputPath",
          "sizeTier.$": "$.sizeTier"
        }
      },
      "ResultPath": "$.planterGeometryResult",
      "Next": "AIMeshCleanup",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleAIError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "AIMeshCleanup": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-modelingPipeline",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "stage": "meshCleanup",
          "previousStageOutput.$": "$.planterGeometryResult.Payload.outputPath",
          "sizeTier.$": "$.sizeTier"
        }
      },
      "ResultPath": "$.meshCleanupResult",
      "Next": "AITextureMarking",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleAIError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "AITextureMarking": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-modelingPipeline",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "stage": "textureMarking",
          "previousStageOutput.$": "$.meshCleanupResult.Payload.outputPath",
          "sizeTier.$": "$.sizeTier"
        }
      },
      "ResultPath": "$.textureMarkingResult",
      "Next": "ProcessSTL",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleAIError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "HandleAIError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-handleError",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "stage": "AI_PIPELINE_ERROR",
          "error.$": "$.error",
          "fallbackToLegacy": true
        }
      },
      "ResultPath": "$.errorResult",
      "Next": "LegacyDownloadPhotos"
    },
    
    "LegacyDownloadPhotos": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-downloadPhotos",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "photoKeys.$": "$.photoKeys"
        }
      },
      "ResultPath": "$.downloadResult",
      "Next": "LegacyGenerateSTL",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleLegacyError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "LegacyGenerateSTL": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-generateSTL",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "photoPath.$": "$.downloadResult.Payload.outputPath",
          "sizeTier.$": "$.sizeTier"
        }
      },
      "ResultPath": "$.generateResult",
      "Next": "ProcessSTL",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleLegacyError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "ProcessSTL": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-processSTL",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "stlPath.$": "$.generateResult.Payload.outputPath || $.textureMarkingResult.Payload.outputPath",
          "sizeTier.$": "$.sizeTier"
        }
      },
      "ResultPath": "$.processResult",
      "Next": "NotifyCustomer",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleLegacyError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "NotifyCustomer": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-notifyCustomer",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "finalSTLPath.$": "$.processResult.Payload.outputPath",
          "pipelineType.$": "$.useAIPipeline"
        }
      },
      "ResultPath": "$.notifyResult",
      "End": true,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ]
    },
    
    "HandleLegacyError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "petplantr-pipeline-dev-handleError",
        "Payload": {
          "orderId.$": "$.orderId",
          "userId.$": "$.userId",
          "stage": "LEGACY_PIPELINE_ERROR",
          "error.$": "$.error"
        }
      },
      "End": true
    }
  }
}
