{
  "modelingPipeline": {
    "version": "1.0.0",
    "stages": {
      "featureExtraction": {
        "enabled": true,
        "model": {
          "name": "vit_base_patch16_224",
          "type": "vision_transformer",
          "checkpoint": "s3://petplantr-models-{stage}/feature-extraction/vit-pet-faces-v1.0.pth"
        },
        "config": {
          "unfrozenLayers": 2,
          "lossFunction": "arcface",
          "margin": 0.5,
          "scale": 64,
          "batchSize": 32,
          "learningRate": 2e-5
        },
        "compute": {
          "instanceType": "g4dn.xlarge",
          "timeoutMinutes": 5,
          "memoryMB": 16384
        }
      },
      "depthEstimation": {
        "enabled": true,
        "models": {
          "primary": "dinov2_vitb14",
          "depth": "midas_dpt_large",
          "ensembleWeight": 0.7
        },
        "config": {
          "inputSize": [384, 384],
          "outputSize": [512, 512],
          "gaussianBlur": 1.5,
          "edgePreservation": true,
          "furEdgeEnhancement": true
        },
        "compute": {
          "instanceType": "g4dn.2xlarge",
          "timeoutMinutes": 3,
          "memoryMB": 32768
        }
      },
      "meshReconstruction": {
        "enabled": true,
        "model": {
          "name": "shape_mvd",
          "checkpoint": "s3://petplantr-models-{stage}/mesh-reconstruction/shape-mvd-pets-v1.0.pth"
        },
        "config": {
          "voxelResolution": 256,
          "smoothingIterations": 3,
          "meshSimplification": true,
          "maxViews": 6
        },
        "training": {
          "multiViewImages": 150,
          "minimumPets": 30,
          "epochs": 20,
          "learningRate": 1e-4,
          "batchSize": 8
        },
        "compute": {
          "instanceType": "p3.2xlarge",
          "timeoutMinutes": 10,
          "memoryMB": 61440
        }
      },
      "planterGeometry": {
        "enabled": true,
        "tools": ["openscad", "meshlab"],
        "config": {
          "cavity": {
            "diameterMm": 80,
            "depthRatio": 0.8,
            "drainageHoleMm": 8
          },
          "shell": {
            "wallThicknessMm": 2.0,
            "minimumThicknessMm": 1.5,
            "preserveFacialGeometry": true
          },
          "base": {
            "flatBottom": true,
            "stabilityMarginMm": 5,
            "feetCount": 4
          }
        },
        "compute": {
          "instanceType": "c5.4xlarge",
          "timeoutMinutes": 2,
          "memoryMB": 32768
        }
      },
      "meshCleanup": {
        "enabled": true,
        "tools": {
          "primary": "instant_meshes",
          "secondary": "meshlab"
        },
        "config": {
          "targetFaces": 180000,
          "operations": [
            "remove_isolated_pieces",
            "remove_duplicate_vertices", 
            "fix_non_manifold_edges",
            "smooth_laplacian"
          ],
          "validation": {
            "manifoldCheck": true,
            "watertightCheck": true,
            "minimumWallThicknessMm": 0.8
          }
        },
        "compute": {
          "instanceType": "c5.2xlarge",
          "timeoutMinutes": 3,
          "memoryMB": 16384
        }
      },
      "textureMarking": {
        "enabled": false,
        "config": {
          "vertexColoring": {
            "bakeResolution": 2048,
            "colorSpace": "srgb"
          },
          "bumpMapping": {
            "heightScaleMm": 0.05,
            "noiseType": "perlin",
            "frequency": 20
          },
          "surfaceDetail": {
            "layerLineMasking": true,
            "proceduralNoiseMm": 0.05,
            "furTextureSimulation": true
          }
        },
        "compute": {
          "instanceType": "g4dn.xlarge",
          "timeoutMinutes": 4,
          "memoryMB": 16384
        }
      }
    },
    "qualityMetrics": {
      "meshValidation": {
        "manifoldRatio": 0.95,
        "maxFaceCount": 180000,
        "positiveVolume": true
      },
      "featurePreservation": {
        "facialLandmarkAccuracy": 0.90,
        "breedCharacteristicRetention": 0.85
      },
      "printability": {
        "minimumFeatureSizeMm": 0.4,
        "maxOverhangAngle": 45,
        "supportRequirement": "minimal"
      }
    },
    "performance": {
      "targetTimes": {
        "featureExtraction": 30,
        "depthEstimation": 45,
        "meshReconstruction": 240,
        "planterGeometry": 30,
        "meshCleanup": 45,
        "textureMarking": 60,
        "totalPipelineSeconds": 450
      }
    },
    "storage": {
      "inputBucket": "petplantr-uploads-{stage}",
      "processingBucket": "petplantr-processing-{stage}",
      "outputBucket": "petplantr-stl-ready-{stage}",
      "modelBucket": "petplantr-models-{stage}",
      "tempStorage": "/tmp/petplantr-processing"
    }
  }
}
