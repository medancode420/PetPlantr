{
  "modelingPipeline": {
    "version": "1.0.0-production",
    "environment": "production",
    "stages": {
      "featureExtraction": {
        "enabled": true,
        "model": {
          "name": "vit_base_patch16_224",
          "type": "vision_transformer",
          "checkpoint": "s3://petplantr-models-prod/vit-feature-extraction/latest.pth",
          "secretsManagerKey": "petplantr/models/vit-weights"
        },
        "config": {
          "unfrozenLayers": 2,
          "lossFunction": "arcface",
          "margin": 0.5,
          "scale": 64,
          "batchSize": 32,
          "learningRate": 2e-5,
          "inputSize": [224, 224],
          "numClasses": 150,
          "features": 768
        },
        "compute": {
          "instanceType": "g4dn.xlarge",
          "timeoutMinutes": 5,
          "memoryMB": 16384,
          "gpuMemoryGB": 16
        },
        "qualityMetrics": {
          "minConfidence": 0.85,
          "featureConsistency": 0.9
        }
      },
      "depthEstimation": {
        "enabled": true,
        "models": {
          "primary": "dinov2_vitb14",
          "depth": "midas_dpt_large",
          "ensembleWeight": 0.7,
          "checkpoints": {
            "dinov2": "s3://petplantr-models-prod/dinov2/dinov2_vitb14_pretrain.pth",
            "midas": "s3://petplantr-models-prod/midas-depth-estimation/latest.pth"
          },
          "secretsManagerKey": "petplantr/models/midas-weights"
        },
        "config": {
          "inputSize": [384, 384],
          "outputSize": [512, 512],
          "gaussianBlur": 1.5,
          "edgePreservation": true,
          "furEdgeEnhancement": true,
          "depthScale": 10.0,
          "depthShift": 0.1
        },
        "compute": {
          "instanceType": "g4dn.2xlarge",
          "timeoutMinutes": 3,
          "memoryMB": 32768,
          "gpuMemoryGB": 16
        },
        "qualityMetrics": {
          "depthConsistency": 0.9,
          "edgePreservation": 0.85
        }
      },
      "meshReconstruction": {
        "enabled": true,
        "model": {
          "name": "shape_mvd",
          "checkpoint": "s3://petplantr-models-prod/shape-mvd-prod/latest.pth",
          "secretsManagerKey": "petplantr/models/shape-mvd-weights",
          "architecture": "unet3d",
          "inputChannels": 4,
          "outputChannels": 1
        },
        "config": {
          "voxelResolution": 256,
          "smoothingIterations": 3,
          "meshSimplification": true,
          "maxViews": 6,
          "marchingCubesLevel": 0.5,
          "postProcessing": {
            "removeDuplicates": true,
            "fillHoles": true,
            "smoothNormals": true
          }
        },
        "training": {
          "multiViewImages": 150,
          "minimumPets": 30,
          "epochs": 20,
          "learningRate": 1e-4,
          "batchSize": 8,
          "augmentation": {
            "rotation": true,
            "lighting": true,
            "background": true
          }
        },
        "compute": {
          "instanceType": "p3.2xlarge",
          "timeoutMinutes": 10,
          "memoryMB": 61440,
          "gpuMemoryGB": 16
        },
        "qualityMetrics": {
          "manifoldRatio": 0.95,
          "vertexCount": {"min": 5000, "max": 50000},
          "faceCount": {"min": 10000, "max": 100000},
          "watertight": true
        }
      },
      "planterGeometry": {
        "enabled": true,
        "tools": ["openscad", "meshlab", "blender"],
        "config": {
          "cavity": {
            "diameterMm": 80,
            "depthRatio": 0.8,
            "drainageHoleMm": 8,
            "shape": "cylindrical"
          },
          "shell": {
            "wallThicknessMm": 2.0,
            "minimumThicknessMm": 1.5,
            "preserveFacialGeometry": true,
            "reinforcement": true
          },
          "base": {
            "flatBottom": true,
            "stabilityMarginMm": 5,
            "feetCount": 4,
            "feetHeightMm": 3
          },
          "scaling": {
            "targetHeightMm": {"small": 80, "medium": 120, "large": 160},
            "maintainProportions": true
          }
        },
        "compute": {
          "instanceType": "c5.4xlarge",
          "timeoutMinutes": 2,
          "memoryMB": 32768
        },
        "qualityMetrics": {
          "cavityVolume": {"min": 50, "max": 200},
          "structuralIntegrity": 0.95,
          "printability": 0.9
        }
      },
      "meshCleanup": {
        "enabled": true,
        "tools": {
          "primary": "instant_meshes",
          "fallback": "meshlab",
          "validation": "netfabb"
        },
        "config": {
          "triangulation": {
            "maxEdgeLength": 2.0,
            "maxAngle": 25,
            "preserveFeatures": true
          },
          "smoothing": {
            "iterations": 5,
            "factor": 0.3,
            "preserveBoundaries": true
          },
          "repair": {
            "removeNonManifold": true,
            "fillHoles": true,
            "removeDuplicates": true,
            "fixNormals": true
          },
          "optimization": {
            "decimate": true,
            "targetReduction": 0.1,
            "preserveTopology": true
          }
        },
        "compute": {
          "instanceType": "c5.2xlarge",
          "timeoutMinutes": 3,
          "memoryMB": 16384
        },
        "qualityMetrics": {
          "manifoldScore": 1.0,
          "printabilityScore": 0.95,
          "geometricError": {"max": 0.1}
        }
      },
      "textureMarking": {
        "enabled": true,
        "models": {
          "texture": "texture_diffusion_v1",
          "marking": "pet_marking_classifier_v2"
        },
        "config": {
          "resolution": 1024,
          "channels": 3,
          "markingTypes": ["spots", "stripes", "patches", "solid"],
          "colorPalette": "natural_pet_colors",
          "uvMapping": {
            "method": "angle_based",
            "seamMinimization": true,
            "distortionLimit": 0.1
          },
          "surfaceDetails": {
            "furTexture": true,
            "noseDetail": true,
            "eyeDetail": true,
            "earDetail": true
          }
        },
        "compute": {
          "instanceType": "g4dn.xlarge",
          "timeoutMinutes": 2,
          "memoryMB": 16384,
          "gpuMemoryGB": 16
        },
        "qualityMetrics": {
          "textureResolution": {"min": 512, "target": 1024},
          "uvDistortion": {"max": 0.15},
          "colorAccuracy": 0.9
        }
      }
    },
    "globalConfig": {
      "dataTypes": {
        "input": ["jpg", "jpeg", "png"],
        "intermediate": ["obj", "ply", "stl"],
        "output": ["stl", "obj"]
      },
      "storage": {
        "tempBucket": "petplantr-processing-dev",
        "modelsBucket": "petplantr-models-prod",
        "outputBucket": "petplantr-stl-ready-dev",
        "retention": {
          "intermediate": "7d",
          "models": "permanent",
          "outputs": "90d"
        }
      },
      "monitoring": {
        "cloudWatch": true,
        "customMetrics": true,
        "errorTracking": true,
        "performanceMetrics": true
      },
      "security": {
        "encryptionAtRest": true,
        "encryptionInTransit": true,
        "accessLogging": true,
        "secretsManager": true
      }
    }
  }
}
