    "/api/v1/mesh/generate": {
      "post": {
        "summary": "Mesh Generate",
        "description": "Stubbed mesh generation with idempotency and Retry-After semantics.\n\nContract goals (for tests):\n- OpenAPI advertises 202 with {poll_after_s, next} and 201 with {id,(next?)}\n- Idempotency-Key header returns the same id for repeat requests within TTL\n- Returns 202 by default with Retry-After header",
        "operationId": "mesh_generate_api_v1_mesh_generate_post",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeshCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "202": {
            "description": "Accepted for async processing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "poll_after_s": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 120
                    },
                    "next": {
                      "type": "string"
                    },
                    "status_url": {
                      "type": "string",
                      "description": "Absolute URL to poll job status"
                    }
                  },
                  "required": [
                    "status",
                    "id",
                    "poll_after_s",
                    "next"
                  ]
                },
                "examples": {
                  "accepted": {
                    "summary": "Accepted",
                    "value": {
                      "status": "accepted",
                      "id": "job_0123456789abcdef",
                      "poll_after_s": 10,
                      "next": "/api/status/job_0123456789abcdef"
                    }
                  }
                },
                "example": {
                  "status": "accepted",
                  "id": "job_abc123",
                  "poll_after_s": 15,
                  "next": "https://api.example.com/api/status/job_abc123",
                  "status_url": "https://api.example.com/api/status/job_abc123"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120
                },
                "description": "Seconds to wait before polling status."
              },
              "X-Queue-Ladder": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Indicates upstream pressure caused the response to be laddered."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                },
                "description": "Prevents caching of async acceptance responses."
              },
              "Location": {
                "description": "Relative or absolute URL to poll job status",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              },
              "Link": {
                "description": "Link to poll job status (rel=\"status\")",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "201": {
            "description": "Created synchronously",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "next": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "invalid_idempotency_key": {
                    "summary": "Invalid Idempotency-Key",
                    "value": {
                      "title": "Invalid Idempotency-Key",
                      "status": 400,
                      "detail": "Header must match allowed charset and length",
                      "instance": "/api/v1/mesh/generate"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "idempotency_conflict": {
                    "summary": "Idempotency conflict",
                    "value": {
                      "title": "Idempotency conflict",
                      "status": 409,
                      "detail": "This Idempotency-Key was used with a different request body.",
                      "instance": "/api/v1/mesh/generate"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds until the client should retry.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "RateLimit-Limit"
              },
              "RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "RateLimit-Remaining"
              },
              "RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "RateLimit-Reset"
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
