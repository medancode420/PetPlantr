{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCurrentUserAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::680604703891:user/petplantr-deploy"
      },
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::petplantr-stl-ready-dev",
        "arn:aws:s3:::petplantr-stl-ready-dev/*"
      ]
    }
  ]
}
