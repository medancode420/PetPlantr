{
  "name": "petplantr-enhanced-api",
  "version": "1.0.0",
  "description": "Enhanced 3D Model Generation API with Performance Optimizations",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:production": "NODE_ENV=production next start -p 3000",
    "lint": "next lint",
    "test": "jest",
    "test:production": "NODE_ENV=production jest",
    "deploy": "npm run build && npm run start:production",
    "health-check": "curl -f http://localhost:3000/api/generate-enhanced-3d-simple?health=true || exit 1",
    "performance-test": "python3 ultimate_performance_demo.py",
    "stress-test": "python3 smart_stress_test.py",
    "validate": "python3 final_performance_validation.py"
  },
  "dependencies": {
    "next": "^15.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "compression": "^1.7.4",
    "redis": "^4.6.0",
    "bull": "^4.12.0",
    "winston": "^3.10.0",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^6.8.0",
    "sharp": "^0.32.0",
    "jimp": "^0.22.0"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "@types/jest": "^29.5.0",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "eslint": "^8.42.0",
    "eslint-config-next": "^15.4.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "3d-modeling",
    "ai",
    "api",
    "performance",
    "nextjs",
    "production"
  ],
  "author": "PetPlantr Team",
  "license": "MIT"
}
