{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.5.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "1.0.0" }
  ],
  "title": "PetPlantr — Hedging & Queue Ladder",
  "uid": "petplantr-hedge-ladder",
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      { "type": "datasource", "name": "DS_PROMETHEUS", "query": "prometheus", "label": "Prometheus" }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Hedge Win‑Rate (last 10m)",
      "id": 1,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ( rate(petplantr_hedge_win_total[10m]) / clamp_min(rate(petplantr_hedge_launch_total[10m]), 1e-9) )"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 20 }, { "color": "green", "value": 30 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Queue Ladder Activations/min (5m)",
      "id": 2,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "rate(petplantr_queue_ladder_activated_total[5m])" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green" }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.5 } ] } } }
    },
    {
      "type": "stat",
      "title": "Synthetic Monitor (last) ms",
      "id": 3,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "expr": "petplantr_synth_last_latency_ms" } ],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [ { "color": "green" }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 1500 } ] } } }
    },
    {
      "type": "stat",
      "title": "SSE Active Clients (gauge)",
      "id": 4,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "expr": "petplantr_sse_active_clients" } ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries",
      "title": "Hedge Launches & Wins (rate/s)",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "rate(petplantr_hedge_launch_total[5m])", "legendFormat": "launch" },
        { "refId": "B", "expr": "rate(petplantr_hedge_win_total[5m])", "legendFormat": "win" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "Hedge Skips by Reason (rate/s)",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "rate(petplantr_hedge_skip_budget_total[5m])", "legendFormat": "budget" },
        { "refId": "B", "expr": "rate(petplantr_hedge_skip_capacity_total[5m])", "legendFormat": "capacity" },
        { "refId": "C", "expr": "rate(petplantr_hedge_skip_parallel_total[5m])", "legendFormat": "parallel_cap" },
        { "refId": "D", "expr": "rate(petplantr_hedge_skip_disabled_total[5m])", "legendFormat": "disabled" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "legend": { "showLegend": true } }
    },
    {
      "type": "timeseries",
      "title": "Provider Busy by Reason (rate/s)",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum by (reason) (rate(petplantr_provider_busy_total[5m]))", "legendFormat": "{{reason}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "legend": { "showLegend": true } }
    },
    {
      "type": "timeseries",
      "title": "Hedge Delay p95 (ms)",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(petplantr_hedge_delay_ms_bucket[5m])))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "type": "timeseries",
      "title": "Queue Depth & Tokens Used",
      "id": 9,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "petplantr_queue_depth", "legendFormat": "queue_depth" },
        { "refId": "B", "expr": "petplantr_tokens_used", "legendFormat": "tokens_used" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "legend": { "showLegend": true } }
    }
  ]
}
