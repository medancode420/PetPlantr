# Mutmut Configuration for PetPlantr
# Mutation testing configuration targeting critical business logic

[mutmut]
# Target critical business logic files for mutation testing
paths_to_mutate = petplantr/pricing.py,petplantr/payments.py,petplantr/stl_validator.py,petplantr/ai_models.py

# Test command to run
runner = python -m pytest tests/ -x --tb=short

# Exclude certain mutation types that often create false positives
exclude_mutants = None

# Cache directory
cache_dir = .mutmut_cache

# Show progress
show_progress = true

# Use multiprocessing for faster mutation testing
use_multiprocessing = true

# Backup original files before mutation
backup_original = true
