{
  "uid": "petplantr-overview",
  "title": "PetPlantr Overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "timezone": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": ["petplantr"],
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate (by path)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (path) (rate(petplantr_http_requests_total[5m]))",
          "legendFormat": "{{path}}",
          "datasource": {"type": "prometheus", "uid": "name:Prometheus"}
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 latency (by path)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path, method) (rate(petplantr_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{path}}",
          "datasource": {"type": "prometheus", "uid": "name:Prometheus"}
        }
      ]
    },
    {
      "type": "stat",
      "title": "Jobs started (5m)",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum(increase(petplantr_jobs_started_total[5m]))",
          "legendFormat": "",
          "datasource": {"type": "prometheus", "uid": "name:Prometheus"}
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto"}
    },
    {
      "type": "stat",
      "title": "Jobs completed success (5m)",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 16},
      "targets": [
        {
          "expr": "sum(increase(petplantr_jobs_completed_total{status=\"success\"}[5m]))",
          "legendFormat": "",
          "datasource": {"type": "prometheus", "uid": "name:Prometheus"}
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto"}
    },
    {
      "type": "stat",
      "title": "Jobs completed failure (5m)",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 16},
      "targets": [
        {
          "expr": "sum(increase(petplantr_jobs_completed_total{status=\"failure\"}[5m]))",
          "legendFormat": "",
          "datasource": {"type": "prometheus", "uid": "name:Prometheus"}
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto"}
    },
    {
      "type": "timeseries",
      "title": "Ticks by reason (rate)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "targets": [
        {
          "expr": "sum by (reason) (rate(petplantr_ticks_total[5m]))",
          "legendFormat": "{{reason}}",
          "datasource": {"type": "prometheus", "uid": "name:Prometheus"}
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Soil capacity (ml) quantiles",
      "description": "Quantiles over observed soil capacity from generated planters (computed from histogram buckets)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(petplantr_soil_capacity_ml_bucket[10m])))",
          "legendFormat": "p50",
          "datasource": {"type": "prometheus", "uid": "name:Prometheus"}
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le) (rate(petplantr_soil_capacity_ml_bucket[10m])))",
          "legendFormat": "p90",
          "datasource": {"type": "prometheus", "uid": "name:Prometheus"}
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(petplantr_soil_capacity_ml_bucket[10m])))",
          "legendFormat": "p99",
          "datasource": {"type": "prometheus", "uid": "name:Prometheus"}
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Soil capacity histogram (ml)",
      "description": "Heatmap built from Prometheus histogram buckets for planter soil capacity",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 36},
      "targets": [
        {
          "expr": "sum by (le) (rate(petplantr_soil_capacity_ml_bucket[10m]))",
          "legendFormat": "{{le}}",
          "format": "time_series",
          "datasource": {"type": "prometheus", "uid": "name:Prometheus"}
        }
      ],
      "options": {
        "legend": {"show": true},
        "tooltip": {"show": true}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ml"
        },
        "overrides": []
      }
    }
  ]
}
